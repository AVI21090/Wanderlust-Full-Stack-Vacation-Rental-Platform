<% layout("/layouts/boilerplate") %>

<style>

.hero-section{

text-align:center;

margin-bottom:4rem;

}

.hero-section h1{

font-size:3.3rem;

font-weight:700;

background:linear-gradient(
90deg,
#fe424d,
#111827
);

-webkit-background-clip:text;

-webkit-text-fill-color:transparent;

}

.hero-section p{

font-size:1.1rem;

color:#6c757d;

}

.trip-card{

border:none;

border-radius:30px;

overflow:hidden;

}

.form-label{

font-weight:700;

}

.form-control,
.form-select{

padding:1rem;

border-radius:18px;

}

.form-control:focus,
.form-select:focus{

box-shadow:none;

border-color:#fe424d;

}

.generate-btn{

background:#111827;

border:none;

padding:15px;

font-weight:700;

border-radius:18px;

transition:0.3s;

}

.generate-btn:hover{

background:black;

transform:translateY(-3px);

}

.result-card{

border:none;

border-radius:30px;

}

.ai-response{

white-space:pre-wrap;

line-height:2;

font-size:1rem;

}

.copy-btn{

border-radius:14px;

font-weight:600;

}

.loader{

display:none;

}

.quick-ideas{

display:flex;

flex-wrap:wrap;

justify-content:center;

gap:10px;

margin-top:2rem;

}

.idea{

padding:10px 18px;

background:#f5f5f5;

border-radius:30px;

font-size:0.95rem;

}

</style>



<div class="container py-5">

<div class="hero-section">

<h1>

✨ AI Trip Planner

</h1>

<p>

Generate personalized itineraries in seconds.

</p>

<div class="quick-ideas">

<div class="idea">

🏔️ Solo Mountain Trip

</div>

<div class="idea">

🏖️ Goa Budget Trip

</div>

<div class="idea">

💑 Romantic Escape

</div>

<div class="idea">

👨‍👩‍👧 Family Vacation

</div>

</div>

</div>



<div class="row justify-content-center">

<div class="col-lg-8">

<div class="card shadow-lg trip-card">

<div class="card-body p-5">

<form

action="/trip-planner"

method="POST"

id="tripForm"

>

<div class="mb-4">

<label class="form-label">

💰 Budget (₹)

</label>

<input

type="number"

name="budget"

class="form-control"

placeholder="15000"

required

>

</div>


<div class="mb-4">

<label class="form-label">

📅 Number of Days

</label>

<input

type="number"

name="days"

class="form-control"

placeholder="5"

required

>

</div>


<div class="mb-4">

<label class="form-label">

🌍 Travel Preference

</label>

<select

name="preference"

class="form-select"

required

>

<option value="">

Select Preference

</option>

<option>

Mountains

</option>

<option>

Beaches

</option>

<option>

Adventure

</option>

<option>

Family Trip

</option>

<option>

Romantic

</option>

<option>

Spiritual

</option>

</select>

</div>


<button

type="submit"

class="btn generate-btn text-white w-100"

>

✨ Generate Trip Plan

</button>


<div

class="text-center mt-4 loader"

id="loader"

>

<div

class="spinner-border text-dark"

role="status"

>

</div>

<p class="mt-3">

Generating your AI trip...

</p>

</div>

</form>

</div>

</div>



<% if(aiResponse){ %>

<div

class="card shadow-lg mt-5 result-card"

>

<div class="card-body p-5">

<div class="d-flex justify-content-between align-items-center">

<h3>

🗺️ Your AI Trip Plan

</h3>

<button

class="btn btn-outline-dark copy-btn"

onclick="copyPlan()"

>

📋 Copy

</button>

</div>

<hr>

<div

id="tripPlan"

class="ai-response"

>

<%= aiResponse %>

</div>

</div>

</div>

<% } %>

</div>

</div>

</div>



<script>

document

.getElementById(

"tripForm"

)

.addEventListener(

"submit",

function(){

document

.getElementById(

"loader"

)

.style.display=

"block";

}

);

function copyPlan(){

const text=

document

.getElementById(

"tripPlan"

)

.innerText;

navigator

.clipboard

.writeText(text);

alert(

"Trip copied successfully!"

);

}

</script>