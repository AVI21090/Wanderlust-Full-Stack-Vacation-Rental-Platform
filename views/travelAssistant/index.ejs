<% layout("/layouts/boilerplate") %>

<style>

.hero-section{

text-align:center;

margin-bottom:4rem;

}

.hero-section h1{

font-size:3.2rem;

font-weight:700;

background:linear-gradient(
90deg,
#fe424d,
#111827
);

-webkit-background-clip:text;

-webkit-text-fill-color:transparent;

}

.hero-section p{

font-size:1.1rem;

color:#6c757d;

}

.assistant-card{

border:none;

border-radius:28px;

overflow:hidden;

}

.form-label{

font-weight:700;

font-size:1.15rem;

}

.form-control{

padding:1rem;

border-radius:18px;

resize:none;

}

.form-control:focus{

box-shadow:none;

border-color:#fe424d;

}

.ask-btn{

background:#111827;

border:none;

padding:15px;

font-weight:700;

border-radius:18px;

transition:0.3s;

}

.ask-btn:hover{

background:black;

transform:translateY(-3px);

}

.response-card{

border:none;

border-radius:28px;

}

.ai-response{

white-space:pre-wrap;

line-height:2;

font-size:1rem;

}

.copy-btn{

border-radius:14px;

font-weight:600;

}

.suggestion-box{

display:flex;

flex-wrap:wrap;

gap:10px;

margin-top:2rem;

justify-content:center;

}

.suggestion{

padding:10px 18px;

border-radius:30px;

background:#f5f5f5;

font-size:0.95rem;

}

.loader{

display:none;

}

</style>


<div class="container py-5">

<div class="hero-section">

<h1>

🤖 AI Travel Assistant

</h1>

<p>

Plan smarter trips with Gemini AI

</p>

<div class="suggestion-box">

<div class="suggestion">

🏖️ Best beaches in Goa

</div>

<div class="suggestion">

🏔️ 5 days in Manali

</div>

<div class="suggestion">

💑 Romantic places in Europe

</div>

<div class="suggestion">

💰 Budget trip to Thailand

</div>

</div>

</div>


<div class="row justify-content-center">

<div class="col-lg-9">

<div class="card shadow-lg assistant-card">

<div class="card-body p-5">

<form

action="/travel-assistant"

method="POST"

id="assistantForm"

>

<div class="mb-4">

<label class="form-label">

Ask Your Travel Question

</label>

<textarea

name="question"

class="form-control"

rows="5"

placeholder="Example: Plan a 4 day budget trip to Goa"

required

></textarea>

</div>


<button

type="submit"

class="btn ask-btn text-white w-100"

>

✨ Ask AI Assistant

</button>


<div

class="text-center mt-4 loader"

id="loader"

>

<div

class="spinner-border text-dark"

role="status"

>

</div>

<p class="mt-3">

Generating AI response...

</p>

</div>

</form>

</div>

</div>



<% if(aiResponse){ %>

<div

class="card shadow-lg mt-5 response-card"

>

<div class="card-body p-5">

<div class="d-flex justify-content-between align-items-center">

<h3>

🤖 AI Response

</h3>

<button

class="btn btn-outline-dark copy-btn"

onclick="copyResponse()"

>

📋 Copy

</button>

</div>

<hr>

<div

id="assistantResponse"

class="ai-response"

>

<%= aiResponse %>

</div>

</div>

</div>

<% } %>


</div>

</div>

</div>



<script>

document

.getElementById(

"assistantForm"

)

.addEventListener(

"submit",

function(){

document

.getElementById(

"loader"

)

.style.display=

"block";

}

);

function copyResponse(){

const text=

document

.getElementById(

"assistantResponse"

)

.innerText;

navigator

.clipboard

.writeText(text);

alert(

"Copied Successfully"

);

}

</script>