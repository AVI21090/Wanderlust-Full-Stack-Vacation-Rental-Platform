<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <h1 class="col-6 offset-3">signUp on wanderlust </h1>
        <div class="col-6 offset-3">
            <form action="/signup" method="POST" class="need-validation" novalidate>

                <div class="mb-3">
                    <label for="username" class="form-label">username</label>
                    <input name="username" id="usename" type="text" class="form-control" required />
                    <div class="valid-feedback">looks good!</div>
                </div>
                <div class="col-6 offset-3">
                    <form action="/signup" method="POST" class="need-validation" novalidate>

                        <div class="mb-3">
                            <label for="email" class="form-label">email</label>
                            <input name="email" id="email" type="text" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">password</label>
                            <input name="password" id="password" type="password" class="form-control" required />
                        </div>
                        <button class="bntn btn-success">signUp</button>
                    </form>
                </div>
        </div>