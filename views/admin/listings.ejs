<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <h1>All Listings</h1>

    <hr>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Title</th>
                <th>Owner</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            <% listings.forEach(listing => { %>

                <tr>

                    <td>
                        <%= listing.title %>
                    </td>

                    <td>
                        <%= listing.owner?.username || "N/A" %>
                    </td>

                    <td>
                        ₹<%= listing.price %>
                    </td>

                    <td>

                        <form
                            action="/admin/listings/<%= listing._id %>?_method=DELETE"
                            method="POST"
                        >

                            <button
                                class="btn btn-danger btn-sm"
                            >
                                Delete
                            </button>

                        </form>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</div>