<% layout("/layouts/boilerplate") %>

<style>

.dashboard-hero{

text-align:center;

margin-bottom:4rem;

}

.dashboard-hero h1{

font-size:3.2rem;

font-weight:700;

}

.dashboard-hero p{

font-size:1.1rem;

color:#6c757d;

}

.stats-card{

border:none;

border-radius:22px;

padding:2rem;

text-align:center;

transition:0.3s;

height:100%;

background:#fff;

}

.stats-card:hover{

transform:translateY(-8px);

box-shadow:0 15px 35px rgba(0,0,0,0.12);

}

.stats-icon{

font-size:2rem;

margin-bottom:1rem;

}

.stats-value{

font-size:2rem;

font-weight:700;

}

.stats-title{

color:#6c757d;

font-weight:600;

}

.revenue-card{

background:#198754;

color:white;

}

.management-card{

border:none;

border-radius:22px;

padding:2rem;

text-align:center;

height:100%;

transition:0.3s;

background:#fff;

}

.management-card:hover{

transform:translateY(-8px);

box-shadow:0 15px 35px rgba(0,0,0,0.12);

}

.management-card i{

font-size:2.2rem;

margin-bottom:1rem;

color:#fe424d;

}

.management-card h5{

font-weight:700;

}

.quick-actions{

margin-bottom:4rem;

}

.quick-btn{

border-radius:30px;

padding:12px 22px;

font-weight:600;

}

</style>



<div class="container py-5">


<div class="dashboard-hero">

<h1>

📊 Admin Dashboard

</h1>

<p>

Monitor your platform, users and business growth.

</p>

</div>



<div class="quick-actions text-center">

<a

href="/listings"

class="btn btn-dark quick-btn me-3"

>

🏠 View Website

</a>

<a

href="/listings/new"

class="btn btn-danger quick-btn"

>

➕ Add Listing

</a>

</div>



<div class="row g-4 mb-5">


<div class="col-lg col-md-6">

<div class="card stats-card">

<div class="stats-icon">

👥

</div>

<div class="stats-value">

<%= totalUsers %>

</div>

<div class="stats-title">

Users

</div>

</div>

</div>



<div class="col-lg col-md-6">

<div class="card stats-card">

<div class="stats-icon">

🏠

</div>

<div class="stats-value">

<%= totalListings %>

</div>

<div class="stats-title">

Listings

</div>

</div>

</div>



<div class="col-lg col-md-6">

<div class="card stats-card">

<div class="stats-icon">

📅

</div>

<div class="stats-value">

<%= totalBookings %>

</div>

<div class="stats-title">

Bookings

</div>

</div>

</div>



<div class="col-lg col-md-6">

<div class="card stats-card">

<div class="stats-icon">

⭐

</div>

<div class="stats-value">

<%= totalReviews %>

</div>

<div class="stats-title">

Reviews

</div>

</div>

</div>



<div class="col-lg-4">

<div class="card stats-card revenue-card">

<div class="stats-icon">

💰

</div>

<div class="stats-value">

₹ <%= totalRevenue.toLocaleString("en-IN") %>

</div>

<div>

Revenue

</div>

</div>

</div>

</div>



<div class="row g-4">


<div class="col-lg-3 col-md-6">

<a

href="/admin/users"

class="text-decoration-none text-dark"

>

<div class="card management-card">

<i class="fa-solid fa-users"></i>

<h5>

Users

</h5>

<p>

Manage platform users

</p>

</div>

</a>

</div>



<div class="col-lg-3 col-md-6">

<a

href="/admin/listings"

class="text-decoration-none text-dark"

>

<div class="card management-card">

<i class="fa-solid fa-house"></i>

<h5>

Listings

</h5>

<p>

Manage all listings

</p>

</div>

</a>

</div>



<div class="col-lg-3 col-md-6">

<a

href="/admin/bookings"

class="text-decoration-none text-dark"

>

<div class="card management-card">

<i class="fa-solid fa-calendar-check"></i>

<h5>

Bookings

</h5>

<p>

Manage all bookings

</p>

</div>

</a>

</div>



<div class="col-lg-3 col-md-6">

<a

href="/admin/reviews"

class="text-decoration-none text-dark"

>

<div class="card management-card">

<i class="fa-solid fa-star"></i>

<h5>

Reviews

</h5>

<p>

Manage all reviews

</p>

</div>

</a>

</div>


</div>

</div>