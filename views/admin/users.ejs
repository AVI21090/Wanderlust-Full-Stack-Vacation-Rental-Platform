<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <h1>All Users</h1>

    <hr>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Email</th>
                <th>Username</th>
                <th>Admin</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            <% users.forEach(user => { %>

                <tr>

                    <td><%= user.email %></td>

                    <td><%= user.username %></td>

                    <td>
                        <%= user.isAdmin ? "Yes" : "No" %>
                    </td>

                    <td>

                        <% if(!user.isAdmin){ %>

                            <form
                                action="/admin/users/<%= user._id %>?_method=DELETE"
                                method="POST"
                            >

                                <button
                                    class="btn btn-danger btn-sm"
                                >
                                    Delete
                                </button>

                            </form>

                        <% } else { %>

                            <span class="text-success">
                                Admin
                            </span>

                        <% } %>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</div>