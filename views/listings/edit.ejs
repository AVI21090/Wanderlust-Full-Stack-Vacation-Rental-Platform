<% layout("/layouts/boilerplate") %>

<style>

.page-title{

text-align:center;

font-size:2.8rem;

font-weight:700;

margin-bottom:0.5rem;

}

.page-subtitle{

text-align:center;

color:#6c757d;

margin-bottom:2rem;

}

.form-card{

border:none;

border-radius:25px;

overflow:hidden;

}

.form-card .card-body{

padding:2.5rem;

}

.form-label{

font-weight:600;

margin-bottom:0.7rem;

}

.form-control{

border-radius:14px;

padding:0.9rem;

}

.form-control:focus{

box-shadow:none;

border-color:#fe424d;

}

.preview-image{

width:100%;

height:300px;

object-fit:cover;

border-radius:18px;

margin-top:1rem;

}

.edit-btn{

width:100%;

background:#111827;

border:none;

padding:14px;

font-size:1rem;

font-weight:600;

border-radius:14px;

transition:0.3s;

}

.edit-btn:hover{

background:black;

transform:translateY(-2px);

}

</style>


<div class="container py-5">

<div class="page-title">

✏️ Edit Listing

</div>

<p class="page-subtitle">

Update your property information.

</p>


<div class="row justify-content-center">

<div class="col-lg-8">

<div class="card shadow-lg form-card">

<div class="card-body">

<form

method="POST"

action="/listings/<%= listing._id %>?_method=PUT"

novalidate

class="needs-validation"

enctype="multipart/form-data"

>

<div class="mb-4">

<label class="form-label">

Title

</label>

<input

name="listing[title]"

value="<%= listing.title %>"

type="text"

class="form-control"

required

>

</div>


<div class="mb-4">

<label class="form-label">

Description

</label>

<textarea

name="listing[description]"

class="form-control"

rows="4"

required

><%= listing.description %></textarea>

</div>


<div class="mb-4">

<label class="form-label">

Current Image

</label>

<img

src="<%= originalImageUrl %>"

class="preview-image"

alt="listing image"

>

</div>


<div class="mb-4">

<label class="form-label">

Upload New Image

</label>

<input

name="listing[image]"

type="file"

class="form-control"

>

</div>


<div class="row">

<div class="col-md-4 mb-4">

<label class="form-label">

Price

</label>

<input

name="listing[price]"

value="<%= listing.price %>"

type="number"

class="form-control"

required

>

</div>


<div class="col-md-8 mb-4">

<label class="form-label">

Country

</label>

<input

name="listing[country]"

value="<%= listing.country %>"

type="text"

class="form-control"

required

>

</div>

</div>


<div class="mb-4">

<label class="form-label">

Location

</label>

<input

name="listing[location]"

value="<%= listing.location %>"

type="text"

class="form-control"

required

>

</div>


<button

class="btn edit-btn"

>

Save Changes

</button>

</form>

</div>

</div>

</div>

</div>

</div>